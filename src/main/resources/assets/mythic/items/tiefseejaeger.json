        "model": "minecraft:item/mythic/L_tiefseejaeger_arrow_icon"
       }
      },
      {
       "when": "rocket",
       "model": {
        "type": "minecraft:model",
        "model": "minecraft:item/mythic/L_tiefseejaeger_firework_icon"
       }
      }
     ],
     "fallback": {
