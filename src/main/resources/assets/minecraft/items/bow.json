{
 "model": {
  "type": "minecraft:select",
  "property": "minecraft:display_context",
  "cases": [
   {
    "when": [
     "gui"
    ],
    "model": {
     "type": "minecraft:condition",
     "property": "minecraft:using_item",
     "on_false": {
      "type": "minecraft:model",
      "model": "minecraft:item/mythic/bow_icon"
     },
     "on_true": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:use_duration",
      "scale": 0.05,
      "entries": [
       {
        "threshold": 0.65,
        "model": {
         "type": "minecraft:model",
         "model": "minecraft:item/mythic/bow_pulling_1_icon"
        }
       },
       {
        "threshold": 0.9,
        "model": {
         "type": "minecraft:model",
         "model": "minecraft:item/mythic/bow_pulling_2_icon"
        }
       }
      ],
      "fallback": {
       "type": "minecraft:model",
       "model": "minecraft:item/mythic/bow_pulling_0_icon"
      }
     }
    }
   }
  ],
  "fallback": {
   "type": "minecraft:condition",
   "property": "minecraft:using_item",
   "on_false": {
    "type": "minecraft:model",
    "model": "minecraft:item/mythic/bow"
   },
   "on_true": {
    "type": "minecraft:range_dispatch",
    "property": "minecraft:use_duration",
    "scale": 0.05,
    "entries": [
     {
      "threshold": 0.65,
      "model": {
       "type": "minecraft:model",
       "model": "minecraft:item/mythic/bow_pulling_1"
      }
     },
     {
      "threshold": 0.9,
      "model": {
       "type": "minecraft:model",
       "model": "minecraft:item/mythic/bow_pulling_2"
      }
     }
    ],
    "fallback": {
     "type": "minecraft:model",
     "model": "minecraft:item/mythic/bow_pulling_0"
    }
   }
  }
 }
}